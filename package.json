{
  "name": "pdf-libre",
  "version": "0.1.0",
  "private": true,
  "description": "Herramientas PDF de código abierto que se ejecutan en tu navegador: convertir JPG a PDF, editar PDF y quitar contraseñas.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jpeg-js": "0.4.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "^4.0.0"
  }
}
